# Stay Studio — environment variables
# Copy this file to .env.local and fill in real values for production.

# Auth is gated behind this flag during development so you can work on the
# tool without setting up Google Workspace SSO credentials first.
AUTH_ENABLED=false

# NextAuth — fill in from Google Cloud Console > Credentials.
# Restrict the OAuth consent screen to @stayinsured.de internally.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain guard — only these email domains can sign in.
ALLOWED_EMAIL_DOMAINS=stayinsured.de

# Database (Phase 1 stub — not wired yet; designs save to localStorage).
# DATABASE_URL=postgres://...

# Object storage (Phase 2 stub — not wired yet).
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
